---
/**
 * Page shell: head, header, footer, and the accessibility floor.
 *
 * Everything here is deliberately inert — no client-side script ships from
 * this layout, and the CSP in public/_headers refuses inline anything, so a
 * future `<script>` will fail loudly rather than quietly widen the surface.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/" — resolved against `site` in astro.config. */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <!-- Rendered from test/og-card.html by `npm run og`, so the card cannot drift
       from the site it advertises. Absolute: scrapers do not resolve relative
       URLs. This page declared summary_large_image with no image behind it for
       a while, which is a promise of a card and the delivery of a blank. -->
  <meta property="og:image" content="https://thejoseki.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Joseki — known-good moves for agentic work. Clawform: safe CloudFormation for Claude Code." />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- iOS ignores SVG favicons on the home screen; same mark, rendered to PNG. -->
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!--
    Cloudflare Web Analytics. Added by hand: the automatic setup on this
    hostname belonged to the previous Pages project and stopped applying when
    the domain moved, which is why the dashboard showed traffic while the
    served HTML carried no beacon at all.

    The token is public by design — it ships in every page — so it belongs in
    the repository rather than in an environment variable that would only
    pretend to hide it. `is:inline` keeps Astro from processing the tag.
  -->
  <script
    is:inline
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token": "bba28df8e32b4b4da2c92feb86ca2088"}'
  ></script>

  <!--
    Plausible Analytics — a second stream alongside Cloudflare Web Analytics.
    CF gives raw pageviews; Plausible gives outbound-link / goal tracking that
    CF cannot do.

    The init lives in /plausible-init.js (same origin) rather than inline, so the
    strict CSP holds without an 'unsafe-inline' or a hash — script-src 'self'
    already covers it. plausible.io is named in BOTH script-src (the tracker)
    and connect-src (events POST to plausible.io/api/event) in public/_headers:
    a script that loads but cannot report sends nothing — the same trap the CF
    beacon note above describes. is:inline keeps Astro from bundling either tag.
  -->
  <script is:inline src="/plausible-init.js"></script>
  <script is:inline defer src="https://plausible.io/js/pa-2qALZT8cWy3ygofqifc-k.js"></script>

  <!--
    Amplitude — product analytics + session replay, a third stream alongside
    Cloudflare (raw pageviews) and Plausible (outbound/goal tracking). Where
    the other two stop at "did a pageview happen", Amplitude answers "what did
    this visitor actually do" (autocapture) and lets it be watched back
    (session replay).

    Loader script first (defines window.amplitude / window.sessionReplay),
    then /amplitude-init.js (same-origin, see that file for why the init call
    isn't inlined here — same CSP reasoning as Plausible above, and for why
    this shares clawform-lp's Amplitude project instead of getting its own).
    Order matters: neither tag is async/defer, so the loader finishes before
    init runs.
  -->
  <script is:inline src="https://cdn.amplitude.com/script/d246bc9d34b889c1d6ba523262865a77.js"></script>
  <script is:inline src="/amplitude-init.js"></script>
</head>

<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="/">
        <img src="/favicon.svg" width="26" height="26" alt="" />
        <span>Joseki</span>
      </a>
      <!-- The product by name, in the header: a visitor who never scrolls
           still learns what this company sells. -->
      <nav class="header-nav" aria-label="Main">
        <a href="/#products">Products</a>
        <a href="https://clawform.thejoseki.com">Clawform</a>
      </nav>
      <a class="btn btn-accent btn-sm" href="mailto:support@thejoseki.com">Get in touch</a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-note">
        Joseki builds toolkits for agentic engineering work.
        <a class="footer-link" href="https://discord.gg/EQ9zvmUWy">Discord</a>
      </p>
      <p class="colophon">&copy; {year} Joseki</p>
    </div>
  </footer>
</body>
</html>

<style>
  /* Layout-local. Tokens and shared primitives live in the stylesheets; only
   * rules that exist nowhere else belong here. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .btn-sm { font-size: var(--fs-xs); padding: 11px 18px; }

  .header-nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    margin-right: 4px;
  }
  .header-nav a {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--on-ink-muted);
  }
  .header-nav a:hover { color: var(--on-ink-strong); }
  /* Room is tight next to the CTA on a phone; the links return on wider
     screens, and the products anchor stays reachable through the hero. */
  @media (max-width: 560px) { .header-nav { display: none; } }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--ink);
  }
  .footer-inner {
    padding-block: 40px 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  .footer-note {
    font-size: var(--fs-sm);
    color: var(--on-ink-muted);
    max-width: 46ch;
  }
  .footer-link {
    color: var(--accent);
    margin-left: 6px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .footer-link:hover { color: var(--accent-hi); }
  .colophon {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
</style>
